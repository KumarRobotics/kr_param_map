  Enabled: true
  Global Options:
    Background Color: 243; 243; 243
    Default Light: true
    Fixed Frame: dragonfly21/odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Theta std deviation: 0.2617993950843811
      Topic: /initialpose
      X std deviation: 0.5
      Y std deviation: 0.5
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /clicked_point
    - Class: waypoint_nav_plugin/WaypointNav
      WaypointsTool:
        default_height: 0
        frame_id: dragonfly21/odom
        topic: /dragonfly21/waypoints
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 20.95751190185547
      Enable Stereo Rendering:
